# Local Development Environment Variables
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=CVCoach
NEXT_PUBLIC_API_URL=http://localhost:3000

# Database (uncomment if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/cvcoach_dev

# Authentication (uncomment if using)
# NEXTAUTH_SECRET=dev-secret-key-change-in-production
# NEXTAUTH_URL=http://localhost:3000

# External APIs (uncomment if using)
# API_KEY=your-dev-api-key
# API_SECRET=your-dev-api-secret
